# Copy this file to .env and fill in the values. Never commit .env!

# --- Common ---
TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO
REDIS_URL=redis://localhost:6379/0

# --- Database ---
# Long random passwords, letters and digits only (they go into URLs), each one from
#   python -c "import secrets; print(secrets.token_hex(24))"
# The Postgres admin, used only inside its container:
POSTGRES_PASSWORD=
# Each bot has its own database user that can reach only that bot's database
SLOTBOOK_DB_PASSWORD=
SPLITMATE_DB_PASSWORD=
CHATGUARD_DB_PASSWORD=
JOBRADAR_DB_PASSWORD=

# --- SlotBook (@slotbook_nl_bot) ---
SLOTBOOK_TOKEN=
# For running the bot outside Docker; docker-compose.yml sets its own
SLOTBOOK_DATABASE_URL=postgresql+asyncpg://slotbook:<SLOTBOOK_DB_PASSWORD>@localhost:5432/slotbook
# Telegram user IDs of the master/admins, comma-separated (get yours from @userinfobot)
SLOTBOOK_ADMIN_IDS=
# Currency prices are shown in (₴, zł, $, €, ...)
SLOTBOOK_CURRENCY=₴
# Shown in /paysupport, e.g. @your_username (optional)
SLOTBOOK_SUPPORT_CONTACT=

# --- SplitMates (@splitmate_nl_bot) ---
# In @BotFather enable inline mode for this bot: /setinline
SPLITMATE_TOKEN=
SPLITMATE_DATABASE_URL=postgresql+asyncpg://splitmate:<SPLITMATE_DB_PASSWORD>@localhost:5432/splitmate

# --- ChatGuard AI (@chatguard_nl_bot) ---
CHATGUARD_TOKEN=
CHATGUARD_DATABASE_URL=postgresql+asyncpg://chatguard:<CHATGUARD_DB_PASSWORD>@localhost:5432/chatguard
# AI checks per chat per day on the free and Pro plans, Pro price in Telegram Stars
CHATGUARD_AI_LIMIT_FREE=50
CHATGUARD_AI_LIMIT_PRO=300
# AI checks per day for the whole bot, a ceiling for your Claude bill
CHATGUARD_AI_LIMIT_GLOBAL=1500
CHATGUARD_PRO_PRICE_STARS=250
# Shown in /paysupport, e.g. @your_username (optional)
CHATGUARD_SUPPORT_CONTACT=

# --- JobRadar (@jobradar_nl_bot) ---
JOBRADAR_TOKEN=
JOBRADAR_DATABASE_URL=postgresql+asyncpg://jobradar:<JOBRADAR_DB_PASSWORD>@localhost:5432/jobradar
# Who may subscribe, comma-separated IDs; empty = anyone
JOBRADAR_ALLOWED_IDS=
# Owners: Pro for free, /gift and /ungift, the AI spend in /status
JOBRADAR_ADMIN_IDS=
# Shown in /paysupport, e.g. @your_username (optional)
JOBRADAR_SUPPORT_CONTACT=
# Personal API token from your Freelancehunt profile (optional: without it Freelancehunt is off)
FREELANCEHUNT_TOKEN=
# The bot's own Gmail box for job alert emails and its app password (optional: /mail is off
# without them). Use a separate account, never your personal one.
JOBRADAR_MAIL_ADDRESS=
JOBRADAR_MAIL_PASSWORD=
# The Free and Pro limits, the AI budget and more: see docker-compose.yml for the defaults

# --- Claude API (ChatGuard AI, JobRadar) ---
ANTHROPIC_API_KEY=
